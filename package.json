{
  "name": "agnusdei-portal",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --tsconfig tsconfig.test.json tests/*.test.mjs",
    "secret-scan": "sh tools/secret-scan.sh",
    "gates": "npm run lint && npm run typecheck && npm test && npm run build && npm run secret-scan",
    "db:test:up": "docker run -d --rm --name portal-test-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
