# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client; used for the Bede provisioning handoff.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bede provisioning endpoint. The portal POSTs a completed onboarding payload here
# so Bede can index the family's curriculum. Leave unset in development and the
# handoff is recorded locally without an outbound call.
BEDE_API_URL=
BEDE_API_KEY=

# Public site URL, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
