# Supabase — the `public` zone only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres, used only for the `consent` schema.
#
# The consent record is deliberately not exposed through PostgREST: a schema
# Supabase does not expose cannot be reached by any client holding any token,
# which is the structural half of parental-consent.md §4's separation. Exposing
# it to make the Supabase SDK usable there would undo the point.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Stripe. The charge is the parental consent (parental-consent.md §3), so it must
# be a genuine captured charge rather than an authorisation hold: the issuer's
# notification to the cardholder is what supplies verification.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# One seat, in the smallest currency unit. A nominal amount suffices in
# principle, but it must be non-zero: a zero charge notifies nobody and silently
# voids the consent method.
SEAT_PRICE_MINOR=4900
SEAT_CURRENCY=usd

NEXT_PUBLIC_SITE_URL=http://localhost:3000
